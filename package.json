{
  "name": "@convay/cast-sdk",
  "version": "0.1.0",
  "description": "Standalone CastAPI web SDK for gated HLS playback: login, stream keys, and segment auth params.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "hls.js": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "hls.js": "^1.6.15",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
